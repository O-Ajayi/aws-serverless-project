# Example terraform.tfvars file
# Copy this file to terraform.tfvars and update with your values

aws_region = "us-east-1"
environment = "dev"
cluster_name = "chaos-broker-eks"
cluster_version = "1.28"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# Master Node Configuration
master_node_instance_type = "t3.micro"

# Worker Node Configuration
worker_node_instance_type = "t3.micro"
worker_node_min_size = 1
worker_node_max_size = 4
worker_node_desired_size = 2

# Cluster Features
enable_cluster_autoscaler = true

# Additional Tags
tags = {
  Team = "ChaosEngineering"
  Purpose = "ChaosTesting"
}

