# Dockerfile for orchestrator service
FROM python:3.9-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY terraform/openshift_deployment/orchestrator/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy orchestrator scripts (from project root context)
COPY terraform/openshift_deployment/orchestrator/orchestrator.py /app/orchestrator.py
COPY terraform/openshift_deployment/orchestrator/orchestrator_service.py /app/orchestrator_service.py

# Make executable
RUN chmod +x /app/orchestrator.py /app/orchestrator_service.py

# Set environment
ENV PYTHONPATH=/app
ENV LOG_LEVEL=INFO
ENV ORCHESTRATOR_PORT=8081

# Expose HTTP port for orchestrator service
EXPOSE 8081

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8081/health || exit 1

# Run the orchestrator HTTP service
CMD ["python", "/app/orchestrator_service.py"]

